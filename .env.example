# Copy to secrets/.env (create the secrets/ folder locally). Never commit real keys.

# AI video (fal.ai Veo 3)
FAL_AI_VEO3_API_KEY=your_fal_ai_key_here

# Prompt generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# YouTube clip moment detection
GEMINI_API_KEY=your_gemini_api_key_here

# CapCut browser login automation (optional; local Selenium flow)
CAPCUT_EMAIL=your_email@example.com
CAPCUT_PASSWORD=your_password_here
